<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Happy birthday, NISCHAL</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Kalam:wght@300;400;700&display=swap" rel="stylesheet">
<style>
  :root {
    --desk: #38484f;
    --paper: #f5f6f2;
    --grid: rgba(64, 104, 186, 0.17);
    --ink: #1f3a8a;
    --pen-red: #b3263e;
    --sticky: #f7e36b;
    --sticky-ink: #3b3410;
    --step: 28px;
  }

  * { box-sizing: border-box; }

  html { background: var(--desk); }

  body {
    margin: 0;
    min-height: 100vh;
    padding: 48px 16px 72px;
    background: var(--desk);
    font-family: "Kalam", "Bradley Hand", "Segoe Print", "Comic Sans MS", cursive;
    color: var(--ink);
  }

  .sheet {
    position: relative;
    max-width: 36rem;
    margin: 0 auto;
    padding: calc(var(--step) * 1.5) 32px calc(var(--step) * 2);
    background-color: var(--paper);
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: var(--step) var(--step);
    background-position: 0 calc(var(--step) * 0.5);
    box-shadow: 0 1px 2px rgba(0,0,0,.25), 0 14px 30px rgba(0,0,0,.28);
    transform: rotate(-0.5deg);
  }

  .sheet::before {
    content: "";
    position: absolute;
    top: -14px;
    left: 50%;
    width: 110px;
    height: 30px;
    transform: translateX(-50%) rotate(2deg);
    background: rgba(226, 222, 200, 0.75);
    box-shadow: 0 1px 2px rgba(0,0,0,.15);
  }

  h1 {
    margin: 0 0 var(--step);
    font-size: 2.3rem;
    font-weight: 700;
    line-height: calc(var(--step) * 2);
    letter-spacing: 0.005em;
  }

  p {
    margin: 0 0 var(--step);
    font-size: 1.15rem;
    font-weight: 400;
    line-height: var(--step);
  }

  .title {
    position: relative;
    margin: 0 0 var(--step);
  }

  .title h1 {
    margin: 0;
  }

  .scribble {
    position: absolute;
    left: 0;
    bottom: 4px;
    width: 64%;
    height: 10px;
    overflow: visible;
    pointer-events: none;
  }

  .scribble path {
    fill: none;
    stroke: var(--pen-red);
    stroke-width: 2.5;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: pen 1.3s cubic-bezier(.4, .1, .3, 1) 0.5s forwards;
  }

  @keyframes pen {
    to { stroke-dashoffset: 0; }
  }

  .stickers {
    position: absolute;
    top: -20px;
    right: 18px;
    display: flex;
    gap: 4px;
  }

  .stickers span {
    display: inline-block;
    font-size: 2.1rem;
    line-height: 1;
    filter:
      drop-shadow(0 0 1px #fff)
      drop-shadow(0 0 1px #fff)
      drop-shadow(0 2px 2px rgba(0,0,0,.3));
    transition: transform .25s ease;
  }

  .stickers span:nth-child(1) { transform: rotate(-12deg); }
  .stickers span:nth-child(2) { transform: rotate(9deg) translateY(6px); }
  .stickers span:nth-child(1):hover { transform: rotate(-4deg) translateY(-3px); }
  .stickers span:nth-child(2):hover { transform: rotate(2deg) translateY(2px); }

  .signoff {
    margin-bottom: 0;
  }

  .from {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: calc(var(--step) * 2);
  }

  .ps {
    margin: var(--step) 0 0;
    color: var(--pen-red);
    font-size: 1.05rem;
  }

  .note {
    position: relative;
    width: min(17rem, 88%);
    margin: calc(var(--step) * -0.5) 0 0 auto;
    padding: 20px 20px 22px;
    background: var(--sticky);
    color: var(--sticky-ink);
    transform: rotate(1.6deg);
    box-shadow: 0 1px 1px rgba(0,0,0,.2), 0 8px 16px rgba(0,0,0,.22);
  }

  .note p {
    margin: 0 0 14px;
    font-size: 1rem;
    line-height: 1.45;
  }

  .copy {
    appearance: none;
    font: inherit;
    font-weight: 700;
    font-size: 1rem;
    padding: 8px 14px;
    color: var(--sticky-ink);
    background: transparent;
    border: 2px solid var(--sticky-ink);
    border-radius: 3px;
    cursor: pointer;
  }

  .copy:hover { background: rgba(59, 52, 16, 0.1); }
  .copy:active { transform: translateY(1px); }
  .copy:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }

  .copy[data-state="done"] {
    background: var(--sticky-ink);
    color: var(--sticky);
  }

  .status {
    display: block;
    min-height: 1.4em;
    margin-top: 10px;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .music {
    position: fixed;
    top: 12px;
    right: 12px;
    z-index: 5;
    min-height: 44px;
    padding: 6px 14px;
    font: inherit;
    font-size: 0.95rem;
    color: #d5dde0;
    background: rgba(0, 0, 0, 0.7);
    border: 1px dashed rgba(213, 221, 224, 0.55);
    border-radius: 3px;
    cursor: pointer;
  }

  .music:hover { background: rgba(0, 0, 0, 0.3); }
  .music:focus-visible { outline: 3px solid var(--sticky); outline-offset: 2px; }

  @media (max-width: 480px) {
    body { padding: 32px 12px 56px; }
    .sheet { padding-left: 22px; padding-right: 22px; }
    h1 { font-size: 1.9rem; }
    p { font-size: 1.05rem; }
    .note { margin-right: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; }
    .scribble path { animation: none; stroke-dashoffset: 0; }
  }
</style>
</head>
<body>

<button class="music" id="music" type="button" aria-pressed="false">Play music</button>

<main class="sheet">
  <div class="stickers" aria-hidden="true"><span>🎂</span><span>🎈</span></div>

  <div class="title">
    <h1>Happy birthday, nichal!</h1>
    <svg class="scribble" viewBox="0 0 300 12" preserveAspectRatio="none" aria-hidden="true">
      <path d="M2 7 C 40 3, 85 10, 135 6 S 225 4, 298 7" pathLength="1"/>
    </svg>
  </div>

  <p>I hope you have the best day today! Eat something really nice (cake counts as a meal on your birthdaay 🍰😆), take it easy, and don't let anything or anyone make your mood down today 😸.</p>

  <p>I hope this year brings you lots of good things, and the kind of small surprises that make you smile out of nowhere. You deserve a really happy year 😽</p>

  <p>Also, thanks for always helping me with my code. You never make me feel bad for asking, and it means a lot to me ✨.</p>

  <p>Keep coding, and keep helping people the way you help me. You're really good at it, and I hope you get to build everything you're dreaming of this year 🥳</p>

  <p class="signoff">Happy birthday again! 🎉
    <span class="from" id="from">from rohan 🐱</span>
  </p>

  <p class="ps"></p>

  <aside class="note" aria-labelledby="note-text">
    <p id="note-text">sorry for late wishes birthday ! </p>
    <button class="copy" id="copy" type="button">Copy mention code</button>
    <span class="status" id="status" role="status" aria-live="polite"></span>
  </aside>
</main>

<script>
  const FROM_NAME = "rohan 🐱";
  const MENTION_CODE = 'Haopy birthdayyy [user id="36513366"] Gokuuu [/user] 🎉🥂✨';
  const MUSIC_URL = "https://raw.githubusercontent.com/mimilenii/birthday-melody/refs/heads/main/HAPPY%20BIRTHDAY%20TO%20YOU%20%20PIANO%20INSTRUMENTAL%20%20BEST%20HAPPY%20BITHDAY%20MUSIC%202021.mp3";
  const VOLUME = 0.45;

  if (FROM_NAME) {
    document.getElementById("from").textContent = "from " + FROM_NAME;
  }

  const button = document.getElementById("copy");
  const status = document.getElementById("status");
  let resetTimer;

  async function copyText(text) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch (err) {
      const box = document.createElement("textarea");
      box.value = text;
      box.setAttribute("readonly", "");
      box.style.position = "fixed";
      box.style.opacity = "0";
      document.body.appendChild(box);
      box.select();
      let ok = false;
      try { ok = document.execCommand("copy"); } catch (e) { ok = false; }
      box.remove();
      return ok;
    }
  }

  button.addEventListener("click", async () => {
    const ok = await copyText(MENTION_CODE);
    clearTimeout(resetTimer);

    if (ok) {
      button.dataset.state = "done";
      button.textContent = "Copied";
      status.textContent = "Copied. Paste it in a comment to mention him.";
    } else {
      status.textContent = "Couldn't copy here. Your browser blocked it, so try opening this page in its own tab.";
    }

    resetTimer = setTimeout(() => {
      delete button.dataset.state;
      button.textContent = "Copy mention code";
    }, 2500);
  });

  const musicBtn = document.getElementById("music");
  const AudioCtx = window.AudioContext || window.webkitAudioContext;
  const gestureEvents = ["pointerup", "touchend", "click", "keydown"];

  let ctx = null;
  let gain = null;
  let audio = null;
  let viaWebAudio = false;

  function setup() {
    audio = new Audio();
    audio.crossOrigin = "anonymous";
    audio.loop = true;
    audio.preload = "auto";
    audio.src = MUSIC_URL;

    if (AudioCtx) {
      try {
        ctx = new AudioCtx();
        gain = ctx.createGain();
        gain.gain.value = 0;
        ctx.createMediaElementSource(audio).connect(gain);
        gain.connect(ctx.destination);
        viaWebAudio = true;
      } catch (e) {
        viaWebAudio = false;
      }
    }

    if (!viaWebAudio) audio.volume = VOLUME;

    audio.addEventListener("play", render);
    audio.addEventListener("pause", render);
    audio.addEventListener("error", useFallback, { once: true });
  }

  function useFallback() {
    const keepPlaying = isPlaying() || wantPlay;
    audio.pause();

    const plain = new Audio(MUSIC_URL);
    plain.loop = true;
    plain.volume = VOLUME;
    plain.addEventListener("play", render);
    plain.addEventListener("pause", render);

    audio = plain;
    viaWebAudio = false;

    if (keepPlaying) plain.play().catch(render);
  }

  let wantPlay = false;

  function isPlaying() {
    return !!audio && !audio.paused;
  }

  function render() {
    const playing = isPlaying();
    musicBtn.textContent = playing ? "Pause music" : "Play music";
    musicBtn.setAttribute("aria-pressed", String(playing));
  }

  function play() {
    wantPlay = true;

    if (viaWebAudio) {
      ctx.resume();
      const t = ctx.currentTime;
      gain.gain.cancelScheduledValues(t);
      gain.gain.setValueAtTime(0, t);
      gain.gain.linearRampToValueAtTime(VOLUME, t + 2.5);
    }

    return audio.play().then(
      () => true,
      () => {
        wantPlay = false;
        render();
        return false;
      }
    );
  }

  function pause() {
    wantPlay = false;
    audio.pause();
  }

  function onGesture(e) {
    if (e.target.closest && e.target.closest("#music")) return;
    if (isPlaying()) {
      detach();
      return;
    }
    play().then((ok) => { if (ok) detach(); });
  }

  function attach() {
    gestureEvents.forEach((name) => document.addEventListener(name, onGesture, true));
  }

  function detach() {
    gestureEvents.forEach((name) => document.removeEventListener(name, onGesture, true));
  }

  musicBtn.addEventListener("click", () => {
    detach();
    if (isPlaying()) {
      pause();
    } else {
      play();
    }
  });

  setup();
  attach();
  if (!ctx || ctx.state === "running") play();
</script>
</body>
</html>
